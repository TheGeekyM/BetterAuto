*.iml
.gradle/
.kotlin/
/local.properties
/.idea/
.DS_Store
/build/
/app/build/
/captures/
.externalNativeBuild/
.cxx/

# Signing keys never go in the repository (the release key: docs/DEVELOPMENT.md, "Releases")
*.jks
*.keystore

# Phone certificates: only our self-signed development pair is public, anything else put here stays local
/app/src/main/assets/*.pem
/app/src/main/assets/*.crt
/app/src/main/assets/*.cer
/app/src/main/assets/*.key
/app/src/main/assets/*.der
/app/src/main/assets/*.p12
/app/src/main/assets/*.pfx
!/app/src/main/assets/phone_cert.pem
!/app/src/main/assets/phone_key.pem

# Spoken greetings say the driver's name: personal, never committed (the voice starts without one)
app/src/main/assets/voice/*/*/greet*.ogg
# Personal takes of any clip (the plain one with the driver's name: "<key>.p1.ogg"), and time-of-day greetings
app/src/main/assets/voice/*/*/*.p[0-9]*.ogg
